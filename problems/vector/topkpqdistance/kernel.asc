#include <cmath>
#include "kernel_operator.h"

/*
 * TopKPQDistance — Ascend C 实现（Direct Invocation）
 * ---------------------------------------------------------------------------
 * 语义：ASC 取最小 k 个升序输出，DES 取最大 k 个降序输出；相等时原索引小者优先
 *       （等价 np.argsort(kind="stable")）。题目用例构造下两阶段算法与全局 top-k
 *       逐位一致，故此处按等价变换实现“全局 top-k + 稳定次序”。
 *
 * 两条路径（host 端按 pq_distance 容量 cap 选择）：
 *   小规模（cap <= SMALL_CAP）：单 block、单次下发，UB 内建堆扫描 + 原地堆排 +
 *       直接写三路输出，省掉 workspace 申请与第二次下发（小 case 只有下发开销）。
 *   通用：blockNum 个 AI Core 各扫 n/blockNum 个元素，本地 top-k 写回 workspace；
 *       再由 stage2 单核归并、原地堆排、按位置 gather 载荷后写三个输出张量。
 *
 * 全流程只做 device 端访存，host 端仅负责 workspace 申请与 kernel 下发。
 * ---------------------------------------------------------------------------
 */

using namespace AscendC;

constexpr int32_t TILE_ELEMS = 2048;    // 每个 tile 2048 个元素（8KB）
constexpr int32_t MAX_BLOCKS = 64;
constexpr int64_t SMALL_CAP = 65536;    // 容量不超过该值时走单 block 快速路径

namespace tkpq {

// a 比 b 更“差”：ASC 值大更差；DES 值小更差；同值索引大更差
__aicore__ inline bool IsWorse(float av, int32_t ai, float bv, int32_t bi, int32_t desc)
{
    if (desc != 0) {
        if (av < bv) { return true; }
        if (av > bv) { return false; }
        return ai > bi;
    }
    if (av > bv) { return true; }
    if (av < bv) { return false; }
    return ai > bi;
}

// 下沉：维护“最差元素在堆顶”的堆（size 为当前堆大小）
__aicore__ inline void SiftDown(LocalTensor<float> hVal, LocalTensor<int32_t> hIdx,
                                int32_t start, int32_t size, int32_t desc)
{
    float tv = hVal.GetValue((uint32_t)start);
    int32_t ti = hIdx.GetValue((uint32_t)start);
    int32_t parent = start;
    int32_t child = (parent << 1) + 1;
    while (child < size) {
        int32_t right = child + 1;
        if (right < size &&
            IsWorse(hVal.GetValue((uint32_t)right), hIdx.GetValue((uint32_t)right),
                    hVal.GetValue((uint32_t)child), hIdx.GetValue((uint32_t)child), desc)) {
            child = right;
        }
        if (!IsWorse(hVal.GetValue((uint32_t)child), hIdx.GetValue((uint32_t)child), tv, ti, desc)) {
            break;
        }
        hVal.SetValue((uint32_t)parent, hVal.GetValue((uint32_t)child));
        hIdx.SetValue((uint32_t)parent, hIdx.GetValue((uint32_t)child));
        parent = child;
        child = (parent << 1) + 1;
    }
    hVal.SetValue((uint32_t)parent, tv);
    hIdx.SetValue((uint32_t)parent, ti);
}

// 每核负责的元素数（8 元素对齐），host / device 用同一公式
__aicore__ inline int64_t ChunkFor(int64_t n, int32_t blockNum)
{
    int64_t c = (n + (int64_t)blockNum - 1) / (int64_t)blockNum;
    return ((c + 7) / 8) * 8;
}

// 在 [lo, hi) 上维护容量 m 的“最差在堆顶”堆，结果留在 hVal/hIdx 的 [0, m) 区间
__aicore__ inline void BuildLocalTopK(LocalTensor<float> hVal, LocalTensor<int32_t> hIdx,
                                      LocalTensor<float> tile, GlobalTensor<float> gIn,
                                      int64_t lo, int64_t hi, int32_t m, int32_t desc)
{
    // ---- 填充前 m 个元素并建堆 ----
    int32_t filled = 0;
    int64_t p = lo;
    int64_t fillEnd = lo + (int64_t)m;
    while (p < fillEnd) {
        int64_t remain = fillEnd - p;
        int32_t tcnt = (remain > (int64_t)TILE_ELEMS) ? TILE_ELEMS : (int32_t)remain;
        int32_t al = tcnt & (~7);
        if (al > 0) {
            DataCopy(tile, gIn[(uint32_t)p], (uint32_t)al);
            PipeBarrier<PIPE_ALL>();
            for (int32_t i = 0; i < al; ++i) {
                hVal.SetValue((uint32_t)(filled + i), tile.GetValue((uint32_t)i));
                hIdx.SetValue((uint32_t)(filled + i), (int32_t)(p + i));
            }
        }
        for (int32_t i = al; i < tcnt; ++i) {
            hVal.SetValue((uint32_t)(filled + i), gIn.GetValue((uint32_t)(p + i)));
            hIdx.SetValue((uint32_t)(filled + i), (int32_t)(p + i));
        }
        filled += tcnt;
        p += tcnt;
    }
    for (int32_t q = (m >> 1) - 1; q >= 0; --q) {
        SiftDown(hVal, hIdx, q, m, desc);
    }

    // ---- 扫描剩余元素 ----
    while (p < hi && ((p & 7) != 0)) {
        float v = gIn.GetValue((uint32_t)p);
        int32_t id = (int32_t)p;
        if (IsWorse(hVal.GetValue(0), hIdx.GetValue(0), v, id, desc)) {
            hVal.SetValue(0, v);
            hIdx.SetValue(0, id);
            SiftDown(hVal, hIdx, 0, m, desc);
        }
        ++p;
    }
    while (p < hi) {
        int64_t remain = hi - p;
        int32_t tcnt = (remain > (int64_t)TILE_ELEMS) ? TILE_ELEMS : (int32_t)remain;
        int32_t al = tcnt & (~7);
        if (al <= 0) {
            while (p < hi) {
                float v = gIn.GetValue((uint32_t)p);
                int32_t id = (int32_t)p;
                if (IsWorse(hVal.GetValue(0), hIdx.GetValue(0), v, id, desc)) {
                    hVal.SetValue(0, v);
                    hIdx.SetValue(0, id);
                    SiftDown(hVal, hIdx, 0, m, desc);
                }
                ++p;
            }
            break;
        }
        DataCopy(tile, gIn[(uint32_t)p], (uint32_t)al);
        PipeBarrier<PIPE_ALL>();
        float rootVal = hVal.GetValue(0);
        int32_t rootIdx = hIdx.GetValue(0);
        for (int32_t i = 0; i < al; ++i) {
            float v = tile.GetValue((uint32_t)i);
            int32_t id = (int32_t)(p + i);
            if (IsWorse(rootVal, rootIdx, v, id, desc)) {
                hVal.SetValue(0, v);
                hIdx.SetValue(0, id);
                SiftDown(hVal, hIdx, 0, m, desc);
                rootVal = hVal.GetValue(0);
                rootIdx = hIdx.GetValue(0);
            }
        }
        p += al;
    }
}

// 原地堆排：弹出堆顶放到尾部，结束后 [0, m) 按 order 方向有序
__aicore__ inline void HeapSortInPlace(LocalTensor<float> hVal, LocalTensor<int32_t> hIdx,
                                       int32_t m, int32_t desc)
{
    for (int32_t i = 0; i < m - 1; ++i) {
        int32_t rest = m - 1 - i;                 // 当前堆最后一个下标（堆大小 = rest + 1）
        float topV = hVal.GetValue(0);
        int32_t topI = hIdx.GetValue(0);
        float lastV = hVal.GetValue((uint32_t)rest);
        int32_t lastI = hIdx.GetValue((uint32_t)rest);
        hVal.SetValue((uint32_t)rest, topV);
        hIdx.SetValue((uint32_t)rest, topI);
        hVal.SetValue(0, lastV);
        hIdx.SetValue(0, lastI);
        SiftDown(hVal, hIdx, 0, rest, desc);
    }
}

// 三路输出：按位置 gather pq_ivf / pq_index 载荷
__aicore__ inline void WriteOutputs(LocalTensor<float> hVal, LocalTensor<int32_t> hIdx,
                                    GlobalTensor<float> gOutVal, GlobalTensor<int32_t> gOutIvf,
                                    GlobalTensor<int32_t> gOutIdx, GlobalTensor<int32_t> gIvf,
                                    GlobalTensor<int32_t> gIndex, int32_t m)
{
    for (int32_t i = 0; i < m; ++i) {
        float v = hVal.GetValue((uint32_t)i);
        int32_t id = hIdx.GetValue((uint32_t)i);
        gOutVal.SetValue((uint32_t)i, v);
        gOutIvf.SetValue((uint32_t)i, gIvf.GetValue((uint32_t)id));
        gOutIdx.SetValue((uint32_t)i, gIndex.GetValue((uint32_t)id));
    }
}

}  // namespace tkpq

// ---------------------------------------------------------------------------
// 小规模路径：单 block 一次算完
// ---------------------------------------------------------------------------
__global__ __vector__ void TopKPQDistanceSmall(
    GM_ADDR actualCountAddr,
    GM_ADDR pqDistanceAddr,
    GM_ADDR pqIvfAddr,
    GM_ADDR pqIndexAddr,
    GM_ADDR outValAddr,
    GM_ADDR outIvfAddr,
    GM_ADDR outIdxAddr,
    int64_t k,
    int32_t desc)
{
    AscendC::InitSocState();

    GlobalTensor<int32_t> gCount;
    gCount.SetGlobalBuffer((__gm__ int32_t*)actualCountAddr, 1);
    int64_t n = (int64_t)gCount.GetValue(0);
    if (n <= 0 || k <= 0) {
        return;
    }
    int32_t m = (int32_t)((n < k) ? n : k);
    int32_t m8 = (m + 7) & (~7);

    GlobalTensor<float> gIn;
    gIn.SetGlobalBuffer((__gm__ float*)pqDistanceAddr, (uint32_t)n);
    GlobalTensor<int32_t> gIvf;
    gIvf.SetGlobalBuffer((__gm__ int32_t*)pqIvfAddr, (uint32_t)n);
    GlobalTensor<int32_t> gIndex;
    gIndex.SetGlobalBuffer((__gm__ int32_t*)pqIndexAddr, (uint32_t)n);
    GlobalTensor<float> gOutVal;
    gOutVal.SetGlobalBuffer((__gm__ float*)outValAddr, (uint32_t)k);
    GlobalTensor<int32_t> gOutIvf;
    gOutIvf.SetGlobalBuffer((__gm__ int32_t*)outIvfAddr, (uint32_t)k);
    GlobalTensor<int32_t> gOutIdx;
    gOutIdx.SetGlobalBuffer((__gm__ int32_t*)outIdxAddr, (uint32_t)k);

    TPipe pipe;
    TBuf<TPosition::VECCALC> valBuf;
    TBuf<TPosition::VECCALC> idxBuf;
    TBuf<TPosition::VECCALC> tileBuf;
    pipe.InitBuffer(valBuf, (uint32_t)(m8 * (int32_t)sizeof(float)));
    pipe.InitBuffer(idxBuf, (uint32_t)(m8 * (int32_t)sizeof(int32_t)));
    pipe.InitBuffer(tileBuf, (uint32_t)(TILE_ELEMS * (int32_t)sizeof(float)));
    LocalTensor<float> hVal = valBuf.Get<float>();
    LocalTensor<int32_t> hIdx = idxBuf.Get<int32_t>();
    LocalTensor<float> tile = tileBuf.Get<float>();

    tkpq::BuildLocalTopK(hVal, hIdx, tile, gIn, 0, n, m, desc);
    tkpq::HeapSortInPlace(hVal, hIdx, m, desc);
    tkpq::WriteOutputs(hVal, hIdx, gOutVal, gOutIvf, gOutIdx, gIvf, gIndex, m);
    PipeBarrier<PIPE_ALL>();
}

// ---------------------------------------------------------------------------
// stage 1：每核局部 top-k
// ---------------------------------------------------------------------------
__global__ __vector__ void TopKPQDistanceStage1(
    GM_ADDR actualCountAddr,
    GM_ADDR pqDistanceAddr,
    GM_ADDR wsValAddr,
    GM_ADDR wsIdxAddr,
    int64_t k,
    int64_t kAligned,
    int32_t blockNum,
    int32_t desc)
{
    AscendC::InitSocState();

    GlobalTensor<int32_t> gCount;
    gCount.SetGlobalBuffer((__gm__ int32_t*)actualCountAddr, 1);
    int64_t n = (int64_t)gCount.GetValue(0);
    if (n <= 0 || blockNum <= 0) {
        return;
    }
    int64_t chunk = tkpq::ChunkFor(n, blockNum);

    int32_t blk = (int32_t)AscendC::GetBlockIdx();
    int64_t lo = (int64_t)blk * chunk;
    if (lo >= n) {
        return;
    }
    int64_t hi = lo + chunk;
    if (hi > n) {
        hi = n;
    }
    int64_t cnt = hi - lo;
    int32_t m = (cnt < k) ? (int32_t)cnt : (int32_t)k;
    if (m <= 0) {
        return;
    }
    int32_t m8 = (m + 7) & (~7);

    GlobalTensor<float> gIn;
    gIn.SetGlobalBuffer((__gm__ float*)pqDistanceAddr, (uint32_t)n);
    GlobalTensor<float> gWsVal;
    gWsVal.SetGlobalBuffer((__gm__ float*)wsValAddr, (uint32_t)(kAligned * (int64_t)blockNum));
    GlobalTensor<int32_t> gWsIdx;
    gWsIdx.SetGlobalBuffer((__gm__ int32_t*)wsIdxAddr, (uint32_t)(kAligned * (int64_t)blockNum));

    TPipe pipe;
    TBuf<TPosition::VECCALC> valBuf;
    TBuf<TPosition::VECCALC> idxBuf;
    TBuf<TPosition::VECCALC> tileBuf;
    pipe.InitBuffer(valBuf, (uint32_t)(m8 * (int32_t)sizeof(float)));
    pipe.InitBuffer(idxBuf, (uint32_t)(m8 * (int32_t)sizeof(int32_t)));
    pipe.InitBuffer(tileBuf, (uint32_t)(TILE_ELEMS * (int32_t)sizeof(float)));
    LocalTensor<float> hVal = valBuf.Get<float>();
    LocalTensor<int32_t> hIdx = idxBuf.Get<int32_t>();
    LocalTensor<float> tile = tileBuf.Get<float>();

    tkpq::BuildLocalTopK(hVal, hIdx, tile, gIn, lo, hi, m, desc);

    int64_t off = (int64_t)blk * kAligned;
    PipeBarrier<PIPE_ALL>();
    DataCopy(gWsVal[(uint32_t)off], hVal, (uint32_t)m8);
    DataCopy(gWsIdx[(uint32_t)off], hIdx, (uint32_t)m8);
    PipeBarrier<PIPE_ALL>();
}

// ---------------------------------------------------------------------------
// stage 2：单核归并 + 堆排 + 载荷 gather，直接写输出
// ---------------------------------------------------------------------------
__global__ __vector__ void TopKPQDistanceStage2(
    GM_ADDR actualCountAddr,
    GM_ADDR wsValAddr,
    GM_ADDR wsIdxAddr,
    GM_ADDR pqIvfAddr,
    GM_ADDR pqIndexAddr,
    GM_ADDR outValAddr,
    GM_ADDR outIvfAddr,
    GM_ADDR outIdxAddr,
    int64_t k,
    int64_t kAligned,
    int32_t blockNum,
    int32_t desc)
{
    AscendC::InitSocState();

    GlobalTensor<int32_t> gCount;
    gCount.SetGlobalBuffer((__gm__ int32_t*)actualCountAddr, 1);
    int64_t n = (int64_t)gCount.GetValue(0);
    if (n <= 0 || blockNum <= 0) {
        return;
    }
    int64_t chunk = tkpq::ChunkFor(n, blockNum);

    int32_t m = (int32_t)k;
    if (m <= 0) {
        return;
    }
    int32_t m8 = (m + 7) & (~7);

    GlobalTensor<float> gWsVal;
    gWsVal.SetGlobalBuffer((__gm__ float*)wsValAddr, (uint32_t)(kAligned * (int64_t)blockNum));
    GlobalTensor<int32_t> gWsIdx;
    gWsIdx.SetGlobalBuffer((__gm__ int32_t*)wsIdxAddr, (uint32_t)(kAligned * (int64_t)blockNum));
    GlobalTensor<int32_t> gIvf;
    gIvf.SetGlobalBuffer((__gm__ int32_t*)pqIvfAddr, (uint32_t)n);
    GlobalTensor<int32_t> gIndex;
    gIndex.SetGlobalBuffer((__gm__ int32_t*)pqIndexAddr, (uint32_t)n);
    GlobalTensor<float> gOutVal;
    gOutVal.SetGlobalBuffer((__gm__ float*)outValAddr, (uint32_t)k);
    GlobalTensor<int32_t> gOutIvf;
    gOutIvf.SetGlobalBuffer((__gm__ int32_t*)outIvfAddr, (uint32_t)k);
    GlobalTensor<int32_t> gOutIdx;
    gOutIdx.SetGlobalBuffer((__gm__ int32_t*)outIdxAddr, (uint32_t)k);

    TPipe pipe;
    TBuf<TPosition::VECCALC> valBuf;
    TBuf<TPosition::VECCALC> idxBuf;
    TBuf<TPosition::VECCALC> tileValBuf;
    TBuf<TPosition::VECCALC> tileIdxBuf;
    pipe.InitBuffer(valBuf, (uint32_t)(m8 * (int32_t)sizeof(float)));
    pipe.InitBuffer(idxBuf, (uint32_t)(m8 * (int32_t)sizeof(int32_t)));
    pipe.InitBuffer(tileValBuf, (uint32_t)(TILE_ELEMS * (int32_t)sizeof(float)));
    pipe.InitBuffer(tileIdxBuf, (uint32_t)(TILE_ELEMS * (int32_t)sizeof(int32_t)));
    LocalTensor<float> hVal = valBuf.Get<float>();
    LocalTensor<int32_t> hIdx = idxBuf.Get<int32_t>();
    LocalTensor<float> tileVal = tileValBuf.Get<float>();
    LocalTensor<int32_t> tileIdx = tileIdxBuf.Get<int32_t>();

    // ---- 归并各核候选 ----
    int32_t filled = 0;
    for (int32_t b = 0; b < blockNum; ++b) {
        int64_t lo = (int64_t)b * chunk;
        if (lo >= n) {
            break;
        }
        int64_t cnt = n - lo;
        if (cnt > chunk) {
            cnt = chunk;
        }
        int32_t cb = (cnt < k) ? (int32_t)cnt : (int32_t)k;
        int32_t cb8 = (cb + 7) & (~7);
        int64_t off = (int64_t)b * kAligned;
        int32_t done = 0;
        while (done < cb8) {
            int32_t t = cb8 - done;
            if (t > TILE_ELEMS) {
                t = TILE_ELEMS;
            }
            DataCopy(tileVal, gWsVal[(uint32_t)(off + done)], (uint32_t)t);
            DataCopy(tileIdx, gWsIdx[(uint32_t)(off + done)], (uint32_t)t);
            PipeBarrier<PIPE_ALL>();
            int32_t lim = cb - done;
            if (lim > t) {
                lim = t;
            }
            for (int32_t i = 0; i < lim; ++i) {
                float v = tileVal.GetValue((uint32_t)i);
                int32_t id = tileIdx.GetValue((uint32_t)i);
                if (filled < m) {
                    hVal.SetValue((uint32_t)filled, v);
                    hIdx.SetValue((uint32_t)filled, id);
                    ++filled;
                    if (filled == m) {
                        for (int32_t q = (m >> 1) - 1; q >= 0; --q) {
                            tkpq::SiftDown(hVal, hIdx, q, m, desc);
                        }
                    }
                } else if (tkpq::IsWorse(hVal.GetValue(0), hIdx.GetValue(0), v, id, desc)) {
                    hVal.SetValue(0, v);
                    hIdx.SetValue(0, id);
                    tkpq::SiftDown(hVal, hIdx, 0, m, desc);
                }
            }
            done += t;
        }
    }

    tkpq::HeapSortInPlace(hVal, hIdx, m, desc);
    tkpq::WriteOutputs(hVal, hIdx, gOutVal, gOutIvf, gOutIdx, gIvf, gIndex, m);
    PipeBarrier<PIPE_ALL>();
}

// ---------------------------------------------------------------------------
// host 端：tiling + 下发
// ---------------------------------------------------------------------------
extern "C" void run_kernel(
    GM_ADDR actual_count,
    const TensorGroupInfo& info_actual_count,
    GM_ADDR pq_distance,
    const TensorGroupInfo& info_pq_distance,
    GM_ADDR grouped_extreme_distance,
    const TensorGroupInfo& info_grouped_extreme_distance,
    GM_ADDR pq_ivf,
    const TensorGroupInfo& info_pq_ivf,
    GM_ADDR pq_index,
    const TensorGroupInfo& info_pq_index,
    GM_ADDR topk_distance,
    const TensorGroupInfo& info_topk_distance,
    GM_ADDR topk_ivf,
    const TensorGroupInfo& info_topk_ivf,
    GM_ADDR topk_index,
    const TensorGroupInfo& info_topk_index,
    int64_t availableCoreNum,
    aclrtStream stream,
    const char* order,
    int64_t k,
    int64_t group_size)
{
    (void)info_actual_count;
    (void)info_grouped_extreme_distance;
    (void)info_pq_ivf;
    (void)info_pq_index;
    (void)info_topk_distance;
    (void)info_topk_ivf;
    (void)info_topk_index;
    (void)grouped_extreme_distance;
    (void)group_size;

    if (k <= 0) {
        return;
    }
    int32_t desc = 1;
    if (order != nullptr) {
        if (order[0] == 'A' && order[1] == 'S' && order[2] == 'C' && order[3] == '\0') {
            desc = 0;
        }
    }

    // 小规模：单 block 一次算完，省掉 workspace 与第二次下发
    int64_t cap = 0;
    if (info_pq_distance.numTensors > 0 && info_pq_distance.tensors[0].numDims > 0) {
        cap = info_pq_distance.tensors[0].shape[0];
    }
    if (cap > 0 && cap <= SMALL_CAP) {
        TopKPQDistanceSmall<<<1, 0, stream>>>(
            actual_count, pq_distance, pq_ivf, pq_index,
            topk_distance, topk_ivf, topk_index, k, desc);
        return;
    }

    int32_t blockNum = (availableCoreNum > 0) ? (int32_t)availableCoreNum : 1;
    if (blockNum > MAX_BLOCKS) {
        blockNum = MAX_BLOCKS;
    }
    if (blockNum < 1) {
        blockNum = 1;
    }
    int64_t kAligned = ((k + 7) / 8) * 8;

    size_t wsBytes = (size_t)blockNum * (size_t)kAligned * 8u + 512u;
    void* wsRaw = nullptr;
    aclError ret = aclrtMalloc(&wsRaw, wsBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS || wsRaw == nullptr) {
        return;
    }
    uint8_t* base = (uint8_t*)wsRaw;
    GM_ADDR wsVal = (GM_ADDR)base;
    GM_ADDR wsIdx = (GM_ADDR)(base + (size_t)blockNum * (size_t)kAligned * 4u);

    TopKPQDistanceStage1<<<blockNum, 0, stream>>>(
        actual_count, pq_distance, wsVal, wsIdx, k, kAligned, blockNum, desc);
    TopKPQDistanceStage2<<<1, 0, stream>>>(
        actual_count, wsVal, wsIdx, pq_ivf, pq_index, topk_distance, topk_ivf, topk_index,
        k, kAligned, blockNum, desc);

    aclrtSynchronizeStream(stream);
    aclrtFree(wsRaw);
}
